<?xml version="1.0" encoding="UTF-8"?>
<OpDefCollection
        PackageName="CactusSquarePackage"
        Domain="cactus"
        Version="1.0"
>
    <OpDefList>
        <OpDef>
            <Name>Square</Name>
            <Description>
                <Content>
                    Element-wise square: out[i] = in[i] * in[i]
                </Content>
            </Description>

            <Input>
                <Name>in[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape>
                    <Rank>ND</Rank>
                    <Text>Any rank; operation is element-wise</Text>
                </Shape>
            </Input>

            <Output>
                <Name>out[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape>
                    <Rank>ND</Rank>
                    <Text>Same shape as input</Text>
                </Shape>
            </Output>

            <SupportedBackend>HTP</SupportedBackend>
        </OpDef>
    </OpDefList>

    <SupplementalOpDefList Backend="HTP">
        <SupportedOps>
            <OpName>Square</OpName>
        </SupportedOps>

        <SupplementalOpDef>
            <Name>Square</Name>

            <Input>
                <Name>in[0]</Name>
                <Datatype>QNN_DATATYPE_FLOAT_16</Datatype>
            </Input>

            <Output>
                <Name>out[0]</Name>
                <Datatype>QNN_DATATYPE_FLOAT_16</Datatype>
            </Output>
        </SupplementalOpDef>
    </SupplementalOpDefList>

</OpDefCollection>
