<?xml version="1.0" encoding="UTF-8"?>
<OpDefCollection
        PackageName="CactusMatMulPackage"
        Domain="cactus"
        Version="1.0"
>
    <OpDefList>
        <OpDef>
            <Name>CactusMatMul</Name>
            <Description>
                <Content>
                    2D matrix multiply: C[M,N] = A[M,K] @ B[K,N], FP16.
                    Tensors represented as 4D [1,1,M,K] / [1,1,K,N] / [1,1,M,N].
                </Content>
            </Description>

            <Input>
                <Name>in[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape>
                    <Rank>4D</Rank>
                    <Text>[1, 1, M, K]</Text>
                </Shape>
            </Input>

            <Input>
                <Name>in[1]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape>
                    <Rank>4D</Rank>
                    <Text>[1, 1, K, N]</Text>
                </Shape>
            </Input>

            <Output>
                <Name>out[0]</Name>
                <Mandatory>true</Mandatory>
                <Datatype>BACKEND_SPECIFIC</Datatype>
                <Shape>
                    <Rank>4D</Rank>
                    <Text>[1, 1, M, N]</Text>
                </Shape>
            </Output>

            <SupportedBackend>HTP</SupportedBackend>
        </OpDef>
    </OpDefList>

    <SupplementalOpDefList Backend="HTP">
        <SupportedOps>
            <OpName>CactusMatMul</OpName>
        </SupportedOps>

        <SupplementalOpDef>
            <Name>CactusMatMul</Name>
            <Input>
                <Name>in[0]</Name>
                <Datatype>QNN_DATATYPE_FLOAT_16</Datatype>
            </Input>
            <Input>
                <Name>in[1]</Name>
                <Datatype>QNN_DATATYPE_FLOAT_16</Datatype>
            </Input>
            <Output>
                <Name>out[0]</Name>
                <Datatype>QNN_DATATYPE_FLOAT_16</Datatype>
            </Output>
        </SupplementalOpDef>
    </SupplementalOpDefList>

</OpDefCollection>
