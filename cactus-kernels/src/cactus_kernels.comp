#extension GL_EXT_shader_16bit_storage : require

#if defined(K_rms_norm_add) || defined(K_rms_norm_add_rms) || defined(K_rms_norm_scale) || defined(K_argmax3) || defined(K_rope_pair_rms) || defined(K_rms2_add_clip) || defined(K_layer_norm) || defined(K_softmax_rows) || defined(K_groupnorm) || defined(K_emb_hadamard_m) || defined(K_emb_ortho_m) || defined(K_attn_fused_i8)
layout(local_size_x = 256) in;
#elif defined(K_attn_fused_i8_512) || defined(K_attn_decode_i8) || defined(K_attn_combine) || defined(K_cq4_gemv2) || defined(K_cq4_gemv_cat) || defined(K_cq4_gemm) || defined(K_softmax_topk) || defined(K_topk_rows) || defined(K_attn_prefill_i8) || defined(K_attn_prefill_ring_i8) || defined(K_attn_f16) || defined(K_deltanet_decode) || defined(K_deltanet_prefill) || defined(K_moe_up) || defined(K_moe_down_acc) || defined(K_moe_transform)
layout(local_size_x = 128) in;
