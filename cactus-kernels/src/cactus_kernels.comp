#ifdef K_emb_hadamard_m
layout(std430, binding = 0) readonly buffer BPK { uint packed_v[]; };
layout(std430, binding = 1) readonly buffer BCB { float16_t cb[]; };
layout(std430, binding = 2) readonly buffer BN { float16_t norms[]; };
layout(std430, binding = 3) readonly buffer BRC { float16_t recip[]; };
layout(std430, binding = 4) readonly buffer BL { uint lsign[]; };
layout(std430, binding = 5) readonly buffer BS { uint rsign[]; };
layout(std430, binding = 6) readonly buffer BP { uint perm[]; };
layout(std430, binding = 7) readonly buffer BRW { uint rows_v[]; };
layout(std430, binding = 8) writeonly buffer BO { float16_t outb[]; };
layout(push_constant) uniform P { uint gs; uint ng; uint K; uint bits; uint pk_base; };
shared float z[512];
uint byte_at(uint b) { return (packed_v[b >> 2] >> ((b & 3u) * 8u)) & 0xFFu; }
uint cq_idx(uint base, uint k) {
    if (bits == 4u) return (byte_at(base + (k >> 1)) >> ((k & 1u) * 4u)) & 0xFu;
    if (bits == 2u) return (byte_at(base + (k >> 2)) >> ((k & 3u) * 2u)) & 0x3u;
    uint bp = k * 3u, bi = bp >> 3, sh = bp & 7u;
    uint v = byte_at(base + bi) >> sh;
    if (sh > 5u) v |= byte_at(base + bi + 1u) << (8u - sh);
    return v & 0x7u;
}
float sgn(uint w, uint k) { int b = int((w >> ((k & 3u) * 8u)) & 0xFFu); return float((b << 24) >> 24); }
void main() {
    uint g = gl_WorkGroupID.x, m = gl_WorkGroupID.y, t = gl_LocalInvocationID.x;
    uint row = rows_v[m];
    uint pgb = (gs * bits + 7u) / 8u;
    uint pg = pk_base + (row * ng + g) * pgb;
    for (uint k = t; k < gs; k += 256u) {
        uint dst = perm[k];
        z[dst] = float(cb[cq_idx(pg, k)]) * sgn(rsign[dst >> 2], dst);
    }
    barrier();
    for (uint h = 1u; h < gs; h <<= 1u) {
        for (uint k = t; k < gs; k += 256u)
            if ((k & h) == 0u) { float a = z[k], b = z[k + h]; z[k] = a + b; z[k + h] = a - b; }
        barrier();
    }
    float nrm = float(norms[row * ng + g]);
    float inv = inversesqrt(float(gs));
    for (uint k = t; k < gs; k += 256u) {
        uint col = g * gs + k;
        outb[m * K + col] = float16_t(z[k] * inv * sgn(lsign[k >> 2], k) * nrm * float(recip[col]));
    }
}
#endif

#ifdef K_emb_ortho_m
layout(std430, binding = 0) readonly buffer BPK { uint packed_v[]; };
layout(std430, binding = 1) readonly buffer BCB { float16_t cb[]; };
layout(std430, binding = 2) readonly buffer BN { float16_t norms[]; };
layout(std430, binding = 3) readonly buffer BRC { float16_t recip[]; };
layout(std430, binding = 4) readonly buffer BRT { float16_t rot[]; };
layout(std430, binding = 5) readonly buffer BRW { uint rows_v[]; };
layout(std430, binding = 6) writeonly buffer BO { float16_t outb[]; };
layout(push_constant) uniform P { uint K; uint M; uint bits; uint il; uint pk_base; float oscale; };
shared float dq[2048];
uint byte_at(uint b) { return (packed_v[b >> 2] >> ((b & 3u) * 8u)) & 0xFFu; }
uint cq_idx_flat(uint base, uint k) {
    if (bits == 4u) return (byte_at(base + (k >> 1)) >> ((k & 1u) * 4u)) & 0xFu;
    if (bits == 2u) return (byte_at(base + (k >> 2)) >> ((k & 3u) * 2u)) & 0x3u;
    uint bp = k * 3u, bi = bp >> 3, sh = bp & 7u;
    uint v = byte_at(base + bi) >> sh;
    if (sh > 5u) v |= byte_at(base + bi + 1u) << (8u - sh);
    return v & 0x7u;
}
uint cq_idx_il4(uint row, uint pgb, uint e) {
    uint v = e >> 4, j = e & 15u, sub = j >> 2, b = j & 3u;
    uint panel = pk_base + (row >> 2) * 4u * pgb;
    uint by = byte_at(panel + (2u * v + (sub >> 1)) * 16u + (row & 3u) * 4u + b);
    return (sub & 1u) != 0u ? (by >> 4) : (by & 0xFu);
}
void main() {
    uint m = gl_WorkGroupID.y, j0 = gl_WorkGroupID.x * 256u, t = gl_LocalInvocationID.x;
    if (m >= M) return;
    uint row = rows_v[m];
    uint pgb = (K * bits + 7u) / 8u;
    for (uint k = t; k < K; k += 256u) {
        uint idx = (il != 0u && bits == 4u) ? cq_idx_il4(row, pgb, k)
                                            : cq_idx_flat(pk_base + row * pgb, k);
        dq[k] = float(cb[idx]);
    }
    barrier();
    float nrm = float(norms[row]);
    uint j = j0 + t;
    if (j >= K) return;
    float acc = 0.0;
    for (uint k = 0u; k < K; ++k) acc += dq[k] * float(rot[j * K + k]);
    float v = h16(acc * nrm * float(recip[j]));
    outb[m * K + j] = float16_t(v * oscale);
}
#endif

