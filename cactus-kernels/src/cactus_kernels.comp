    uint g = gl_WorkGroupID.x, m = gl_WorkGroupID.y, t = gl_LocalInvocationID.x;
    uint mbase = m * K;
    for (uint k = t; k < gs; k += 64u) { uint gk = g*gs + k; z[k] = float(xin[mbase + gk])*float(recip[gk])*lsgn(k); }
    barrier();
    for (uint h = 1u; h < gs; h <<= 1u) {
        for (uint k = t; k < gs; k += 64u) if ((k & h) == 0u) { float a = z[k], b = z[k + h]; z[k] = a + b; z[k + h] = a - b; }
        barrier();
    }
    float s = inversesqrt(float(gs));
    for (uint k = t; k < gs; k += 64u) z[k] = z[k]*s*rsgn(k);
    barrier();
    for (uint k = t; k < gs; k += 64u) code[mbase + g*gs + k] = float16_t(z[perm[k]]);
}
#endif

#ifdef K_cq4_gemm
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(std430, binding = 0) readonly buffer BC { uvec4 code_v[]; };
layout(std430, binding = 1) readonly buffer BPK { uint packed_w[]; };
layout(std430, binding = 2) readonly buffer BCB { float16_t codebook[]; };
layout(std430, binding = 3) readonly buffer BN { float16_t norms[]; };
layout(std430, binding = 4) writeonly buffer BY { float16_t y[]; };
layout(std430, binding = 5) readonly buffer BPV { uvec4 packed_v[]; };
layout(push_constant) uniform P { uint gs; uint ng; uint pgb; uint N; uint il; uint M; };
shared float16_t cbh[16];
shared uvec4 scode[8][128];
shared vec4 part[8][8];
void main() {
    uint t = gl_LocalInvocationID.x, sg = gl_SubgroupID, nsg = gl_NumSubgroups;
    uint K = ng * gs;
    uint m0 = gl_WorkGroupID.y * 8u;
    uint mt = min(8u, M - m0);
    if (t < 16u) cbh[t] = codebook[t];
    for (uint row0 = gl_WorkGroupID.x * 4u; row0 < N; row0 += gl_NumWorkGroups.x * 4u) {
        uint n0 = row0;
        vec4 acc[8];
        for (uint m = 0u; m < 8u; ++m) acc[m] = vec4(0.0);
        for (uint kb = 0u; kb < K; kb += 1024u) {
            uint clen = min(1024u, K - kb);
            barrier();
            for (uint m = 0u; m < mt; ++m)
                for (uint i = t; i < clen / 8u; i += 128u)
                    scode[m][i] = code_v[((m0 + m) * K + kb) / 8u + i];
            barrier();
            for (uint off = t * 16u; off < clen; off += 2048u) {
                uint base = kb + off;
                uint g = base / gs, e = base - g * gs;
                if (il != 0u) {
                    uint pw = ((n0 >> 2) * ng + g) * pgb + (e >> 4) * 8u;
                    uint nb = ((n0 >> 2) * ng + g) << 2;
                    uvec4 A4 = packed_v[pw >> 2];
                    uvec4 B4 = packed_v[(pw >> 2) + 1u];
                    for (uint r = 0u; r < 4u; ++r) {
                        uint A = A4[r], B = B4[r];
                        f16vec2 wa0 = f16vec2(cbh[A & 0xFu],         cbh[(A >> 8) & 0xFu]);
                        f16vec2 wa1 = f16vec2(cbh[(A >> 16) & 0xFu], cbh[(A >> 24) & 0xFu]);
                        f16vec2 wa2 = f16vec2(cbh[(A >> 4) & 0xFu],  cbh[(A >> 12) & 0xFu]);
                        f16vec2 wa3 = f16vec2(cbh[(A >> 20) & 0xFu], cbh[(A >> 28) & 0xFu]);
                        f16vec2 wb0 = f16vec2(cbh[B & 0xFu],         cbh[(B >> 8) & 0xFu]);
                        f16vec2 wb1 = f16vec2(cbh[(B >> 16) & 0xFu], cbh[(B >> 24) & 0xFu]);
                        f16vec2 wb2 = f16vec2(cbh[(B >> 4) & 0xFu],  cbh[(B >> 12) & 0xFu]);
                        f16vec2 wb3 = f16vec2(cbh[(B >> 20) & 0xFu], cbh[(B >> 28) & 0xFu]);
                        float nrm = float(norms[nb + r]);
                        for (uint m = 0u; m < mt; ++m) {
                            uvec4 q0 = scode[m][off >> 3];
                            uvec4 q1 = scode[m][(off >> 3) + 1u];
                            f16vec2 sum = wa0 * unpackFloat2x16(q0.x) + wa1 * unpackFloat2x16(q0.y)
                                        + wa2 * unpackFloat2x16(q0.z) + wa3 * unpackFloat2x16(q0.w)
                                        + wb0 * unpackFloat2x16(q1.x) + wb1 * unpackFloat2x16(q1.y)
                                        + wb2 * unpackFloat2x16(q1.z) + wb3 * unpackFloat2x16(q1.w);
                            acc[m][r] += nrm * (float(sum.x) + float(sum.y));
                        }
                    }
                } else {
                    for (uint r = 0u; r < 4u; ++r) {
                        uint n = n0 + r;
                        if (n >= N) break;
                        uint bw = (n * ng + g) * (pgb >> 2) + (e >> 3);
                        uint A = packed_w[bw];
                        uint B = packed_w[bw + 1u];
                        f16vec2 wa0 = f16vec2(cbh[A & 0xFu],         cbh[(A >> 4) & 0xFu]);
                        f16vec2 wa1 = f16vec2(cbh[(A >> 8) & 0xFu],  cbh[(A >> 12) & 0xFu]);
                        f16vec2 wa2 = f16vec2(cbh[(A >> 16) & 0xFu], cbh[(A >> 20) & 0xFu]);
                        f16vec2 wa3 = f16vec2(cbh[(A >> 24) & 0xFu], cbh[A >> 28]);
                        f16vec2 wb0 = f16vec2(cbh[B & 0xFu],         cbh[(B >> 4) & 0xFu]);
                        f16vec2 wb1 = f16vec2(cbh[(B >> 8) & 0xFu],  cbh[(B >> 12) & 0xFu]);
                        f16vec2 wb2 = f16vec2(cbh[(B >> 16) & 0xFu], cbh[(B >> 20) & 0xFu]);
                        f16vec2 wb3 = f16vec2(cbh[(B >> 24) & 0xFu], cbh[B >> 28]);
                        float nrm = float(norms[n * ng + g]);
                        for (uint m = 0u; m < mt; ++m) {
                            uvec4 q0 = scode[m][off >> 3];
                            uvec4 q1 = scode[m][(off >> 3) + 1u];
                            f16vec2 sum = wa0 * unpackFloat2x16(q0.x) + wa1 * unpackFloat2x16(q0.y)
                                        + wa2 * unpackFloat2x16(q0.z) + wa3 * unpackFloat2x16(q0.w)
                                        + wb0 * unpackFloat2x16(q1.x) + wb1 * unpackFloat2x16(q1.y)
                                        + wb2 * unpackFloat2x16(q1.z) + wb3 * unpackFloat2x16(q1.w);
                            acc[m][r] += nrm * (float(sum.x) + float(sum.y));
                        }
                    }
                }
            }
        }
        for (uint m = 0u; m < mt; ++m) {
            vec4 s = subgroupAdd(acc[m]);
            if (nsg == 1u) {
                if (t == 0u)
                    for (uint r = 0u; r < 4u; ++r)
                        if (n0 + r < N) y[(m0 + m) * N + n0 + r] = float16_t(s[r]);
            } else {
                if (subgroupElect()) part[m][sg] = s;
            }
        }
        if (nsg != 1u) {
            barrier();
            if (t == 0u) {
                for (uint m = 0u; m < mt; ++m) {
                    vec4 s = part[m][0];
                    for (uint i = 1u; i < nsg; ++i) s += part[m][i];
                    for (uint r = 0u; r < 4u; ++r)
                        if (n0 + r < N) y[(m0 + m) * N + n0 + r] = float16_t(s[r]);
                }
            }
            barrier();
        }
    }
}
#endif

#ifdef K_argmax
layout(std430, binding = 0) readonly buffer BL { float16_t logits[]; };
layout(std430, binding = 1) writeonly buffer BO { float outp[]; };
layout(push_constant) uniform P { uint n; };
shared float vmax[64];
shared uint vidx[64];
void main() {
    uint t = gl_LocalInvocationID.x, gid = gl_WorkGroupID.x, G = gl_NumWorkGroups.x;
    float best = -3.4e38;
    uint bi = 0u;
    for (uint i = gid*64u + t; i < n; i += G*64u) {
        float v = float(logits[i]);
        if (v > best) { best = v; bi = i; }
    }
    vmax[t] = best; vidx[t] = bi;
    barrier();
    for (uint s = 32u; s > 0u; s >>= 1u) {
        if (t < s && vmax[t + s] > vmax[t]) { vmax[t] = vmax[t + s]; vidx[t] = vidx[t + s]; }
        barrier();
    }
    if (t == 0u) { outp[gid*2u] = vmax[0]; outp[gid*2u + 1u] = uintBitsToFloat(vidx[0]); }
}
#endif

#ifdef K_rope_pair_rms
layout(std430, binding = 0) readonly buffer BX { float16_t x[]; };
layout(std430, binding = 1) readonly buffer BW { float16_t w[]; };
layout(std430, binding = 2) readonly buffer BC { float16_t c[]; };
layout(std430, binding = 3) readonly buffer BS { float16_t s[]; };
layout(std430, binding = 4) writeonly buffer BY { float16_t y[]; };
layout(push_constant) uniform P { uint D; float eps; };
shared float red[256];
shared float xn[1024];
void main() {
    uint h = gl_WorkGroupID.x, t = gl_LocalInvocationID.x;
    uint base = h * D;
    float ss = 0.0;
    for (uint i = t; i < D; i += 256u) { float v = float(x[base + i]); ss += v * v; }
    red[t] = ss;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) { if (t < st) red[t] += red[t + st]; barrier(); }
    float inv = 1.0 / sqrt(red[0] / float(D) + eps);
    for (uint i = t; i < D; i += 256u) xn[i] = h16(float(x[base + i]) * inv * float(w[i]));
    barrier();
    uint half_d = D / 2u;
    for (uint i = t; i < D; i += 256u) {
        float xv = xn[i];
        float rh = (i < half_d) ? -xn[i + half_d] : xn[i - half_d];
        y[base + i] = float16_t(xv * float(c[i]) + rh * float(s[i]));
    }
}
#endif

#ifdef K_rms2_add_clip
layout(std430, binding = 0) readonly buffer BA { float16_t a[]; };
layout(std430, binding = 1) readonly buffer BWA { float16_t wa[]; };
layout(std430, binding = 2) readonly buffer BB { float16_t b[]; };
layout(std430, binding = 3) readonly buffer BWB { float16_t wb[]; };
layout(std430, binding = 4) writeonly buffer BY { float16_t y[]; };
layout(push_constant) uniform P { uint D; float eps_a; float eps_b; };
shared float red[512];
void main() {
    uint t = gl_LocalInvocationID.x;
    float sa = 0.0, sb = 0.0;
    for (uint i = t; i < D; i += 256u) {
        float va = float(a[i]), vb = float(b[i]);
        sa += va * va; sb += vb * vb;
    }
    red[t] = sa; red[256u + t] = sb;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) {
        if (t < st) { red[t] += red[t + st]; red[256u + t] += red[256u + t + st]; }
        barrier();
    }
    float inva = 1.0 / sqrt(red[0] / float(D) + eps_a);
    float invb = 1.0 / sqrt(red[256] / float(D) + eps_b);
    for (uint i = t; i < D; i += 256u) {
        float ya = h16(float(a[i]) * inva * float(wa[i]));
        float yb = h16(float(b[i]) * invb * float(wb[i]));
        y[i] = float16_t(clamp(ya + yb, -65500.0, 65500.0));
    }
}
#endif

#ifdef K_gather
layout(std430, binding = 0) readonly buffer BT { float16_t table_v[]; };
layout(std430, binding = 1) readonly buffer BR { uint rows_v[]; };
layout(std430, binding = 2) writeonly buffer BY { float16_t y[]; };
