        float x1 = float(x[xb + uint(center)]);
        float x2 = (center + 1 < int(L)) ? float(x[xb + uint(center + 1)]) : 0.0;
        acc += x0 * float(w[wb + c * 3u]) + x1 * float(w[wb + c * 3u + 1u]) + x2 * float(w[wb + c * 3u + 2u]);
    }
    y[co * Lout + l] = float16_t(acc);
}
