#ifdef K_bcast_binary
layout(std430, binding = 0) readonly buffer BA { float16_t a[]; };
layout(std430, binding = 1) readonly buffer BB { float16_t b[]; };
layout(std430, binding = 2) writeonly buffer BY { float16_t y[]; };
layout(push_constant) uniform P { int op; uint ndim; uint total; uint oshape[8]; uint astr[8]; uint bstr[8]; };
void main() {
    uint stride = 64u * gl_NumWorkGroups.x;
    for (uint i = gl_GlobalInvocationID.x; i < total; i += stride) {
        uint rem = i, ai = 0u, bi = 0u;
        for (int d = int(ndim) - 1; d >= 0; --d) {
            uint c = rem % oshape[d]; rem /= oshape[d];
            ai += c * astr[d]; bi += c * bstr[d];
        }
        float av = float(a[ai]), bv = float(b[bi]), r;
        if (op == 2) r = av - bv;
        else if (op == 3) r = av * bv;
        else if (op == 4) r = av / bv;
        else if (op == 5) r = (av != bv) ? 1.0 : 0.0;
        else r = av + bv;
        if (op == 1) r = clamp(r, -65500.0, 65500.0);
        y[i] = float16_t(r);
    }
}
#endif

#ifdef K_concat2
layout(std430, binding = 0) readonly buffer BA { float16_t a[]; };
layout(std430, binding = 1) readonly buffer BB { float16_t b[]; };
layout(std430, binding = 2) writeonly buffer BY { float16_t y[]; };
layout(push_constant) uniform P { uint outer; uint a_axis; uint b_axis; uint inner; };
void main() {
    uint stride = 64u * gl_NumWorkGroups.x;
    uint span = (a_axis + b_axis) * inner;
    uint total = outer * span;
    for (uint i = gl_GlobalInvocationID.x; i < total; i += stride) {
        uint u = i / span, r = i % span, ax = r / inner, e = r % inner;
        y[i] = (ax < a_axis) ? a[(u * a_axis + ax) * inner + e]
                             : b[(u * b_axis + (ax - a_axis)) * inner + e];
    }
}
#endif

#ifdef K_rms_norm_add
layout(std430, binding = 0) readonly buffer BI { float16_t xin[]; };
layout(std430, binding = 1) readonly buffer BW { float16_t w[]; };
layout(std430, binding = 2) readonly buffer BR { float16_t res[]; };
layout(std430, binding = 3) writeonly buffer BY { float16_t y[]; };
layout(push_constant) uniform P { uint dim; float eps; float out_scale; };
shared float red[256];
void main() {
    uint row = gl_WorkGroupID.x, t = gl_LocalInvocationID.x;
    uint base = row * dim;
    float partial = 0.0;
    for (uint i = t; i < dim; i += 256u) { float v = float(xin[base + i]); partial += v * v; }
    red[t] = partial;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) { if (t < s) red[t] += red[t + s]; barrier(); }
    float inv = 1.0 / sqrt(red[0] / float(dim) + eps);
    for (uint i = t; i < dim; i += 256u) {
        float rr = (float(res[base + i]) + h16(float(xin[base + i]) * inv * float(w[i]))) * out_scale;
        y[base + i] = float16_t(clamp(rr, -65500.0, 65500.0));
    }
}
#endif

#ifdef K_rms_norm_add_rms
layout(std430, binding = 0) readonly buffer BI { float16_t xin[]; };
layout(std430, binding = 1) readonly buffer BW1 { float16_t w1[]; };
layout(std430, binding = 2) readonly buffer BR { float16_t res[]; };
layout(std430, binding = 3) buffer BH { float16_t hout[]; };
layout(std430, binding = 4) readonly buffer BW2 { float16_t w2[]; };
layout(std430, binding = 5) writeonly buffer BX { float16_t xnout[]; };
layout(push_constant) uniform P { uint dim; float eps; float out_scale; };
shared float red[256];
void main() {
    uint row = gl_WorkGroupID.x, t = gl_LocalInvocationID.x;
    uint base = row * dim;
    float partial = 0.0;
    for (uint i = t; i < dim; i += 256u) { float v = float(xin[base + i]); partial += v * v; }
    red[t] = partial;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) { if (t < s) red[t] += red[t + s]; barrier(); }
    float inv = 1.0 / sqrt(red[0] / float(dim) + eps);
    barrier();
    float p2 = 0.0;
    for (uint i = t; i < dim; i += 256u) {
        float rr = (float(res[base + i]) + h16(float(xin[base + i]) * inv * float(w1[i]))) * out_scale;
        float hv = h16(clamp(rr, -65500.0, 65500.0));
        hout[base + i] = float16_t(hv);
        p2 += hv * hv;
    }
    red[t] = p2;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) { if (t < s) red[t] += red[t + s]; barrier(); }
    float inv2 = 1.0 / sqrt(red[0] / float(dim) + eps);
    for (uint i = t; i < dim; i += 256u)
        xnout[base + i] = float16_t(float(hout[base + i]) * inv2 * float(w2[i]));
}
#endif

