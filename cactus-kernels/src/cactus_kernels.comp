#ifdef K_reduce_axis
layout(std430, binding = 0) readonly buffer BIH { float16_t in_h[]; };
layout(std430, binding = 1) readonly buffer BIF { float in_f[]; };
layout(std430, binding = 2) writeonly buffer BYH { float16_t y_h[]; };
layout(std430, binding = 3) writeonly buffer BYF { float y_f[]; };
layout(push_constant) uniform P { uint axis_size; uint inner; uint n; int op; uint f32; };
float rd(uint idx) { return (f32 != 0u) ? in_f[idx] : float(in_h[idx]); }
