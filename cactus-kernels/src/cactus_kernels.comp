#ifdef K_softmax_topk
layout(std430, binding = 0) readonly buffer BI { float16_t xin[]; };
layout(std430, binding = 1) writeonly buffer BP2 { float16_t probs[]; };
layout(std430, binding = 2) buffer BK { float tk[]; };
layout(push_constant) uniform P { uint E; uint k; uint B; float scale; };
shared float sv[128];
shared uint si[128];
shared uint chosen[16];
void main() {
    uint row = gl_WorkGroupID.x, t = gl_LocalInvocationID.x;
    uint xb = row * E;
    float mx = -1.0 / 0.0;
    for (uint i = t; i < E; i += 128u) mx = max(mx, h16(float(xin[xb + i]) * scale));
    sv[t] = mx;
    barrier();
    for (uint st = 64u; st > 0u; st >>= 1u) { if (t < st) sv[t] = max(sv[t], sv[t + st]); barrier(); }
    mx = sv[0];
    barrier();
    float sum = 0.0;
    for (uint i = t; i < E; i += 128u) sum += exp(h16(float(xin[xb + i]) * scale) - mx);
    sv[t] = sum;
    barrier();
    for (uint st = 64u; st > 0u; st >>= 1u) { if (t < st) sv[t] += sv[t + st]; barrier(); }
    float inv = 1.0 / sv[0];
    barrier();
    for (uint i = t; i < E; i += 128u)
        probs[xb + i] = float16_t(exp(h16(float(xin[xb + i]) * scale) - mx) * inv);
    for (uint j = 0u; j < k; ++j) {
        float best = -1.0 / 0.0;
        uint bi = 0xFFFFFFFFu;
        for (uint i = t; i < E; i += 128u) {
            bool taken = false;
            for (uint p = 0u; p < j; ++p) if (chosen[p] == i) taken = true;
            float v = h16(float(xin[xb + i]) * scale);
            if (!taken && (v > best || (v == best && i < bi))) { best = v; bi = i; }
        }
        sv[t] = best; si[t] = bi;
        barrier();
        for (uint st = 64u; st > 0u; st >>= 1u) {
            if (t < st && (sv[t + st] > sv[t] || (sv[t + st] == sv[t] && si[t + st] < si[t]))) {
                sv[t] = sv[t + st]; si[t] = si[t + st];
            }
            barrier();
        }
        if (t == 0u) {
            chosen[j] = si[0];
            tk[row * k + j] = float(si[0]);
            tk[B * k + row * k + j] = sv[0];
        }
        barrier();
    }
}
#endif

#ifdef K_topk_rows
