                int op = code & 15;
                bool rhs = (code & 16) != 0;
                bool sf32 = (code & 32) != 0;
                uint bmode = (uint(code) >> 8) & 3u;
                uint si = i;
                if (bmode == 1u) si = i / inner;
                else if (bmode == 2u) si = i % inner;
                float o = sside(slot, sf32, si);
                float a = rhs ? o : x, b = rhs ? x : o;
                float r;
                if (op == 2) r = a - b;
                else if (op == 3) r = a * b;
                else if (op == 4) r = a / b;
                else if (op == 5) r = (a != b) ? 1.0 : 0.0;
                else r = a + b;
                if (op == 1) r = clamp(r, -65500.0, 65500.0);
                x = r;
            } else if (kind == 0) {
                if (code == 0) x = gelu_tanh(x);
                else if (code == 1) x = tanh(clamp(x, -30.0, 30.0));
                else if (code == 2) x = x / (1.0 + exp(-x));
                else if (code == 4) x = 0.5 * x * (1.0 + erf_approx(x * 0.70710678));
                else if (code == 5) x = 1.0 / (1.0 + exp(-x));
                else x = max(x, 0.0);
            } else if (kind == 1) {
                x = sc_apply(x, p0, code);
            } else {
                x = clamp(x, p0, p1);
            }
            if (!prec32) x = h16(x);
        }
        if (out32) y_f[i] = x; else y_h[i] = float16_t(x);
    }
}
#endif

#ifdef K_conv_cache_append
layout(std430, binding = 0) readonly buffer BSH { float16_t src_h[]; };
layout(std430, binding = 1) readonly buffer BSF { float src_f[]; };
layout(std430, binding = 2) buffer BR { float16_t ring[]; };
layout(std430, binding = 3) writeonly buffer BO { float16_t outb[]; };
layout(push_constant) uniform P { uint hd; uint ws; uint nnew; uint head0; uint count_new; uint num_rows; uint src_f32; uint ring_off; };
void main() {
    uint x = gl_GlobalInvocationID.x, y = gl_WorkGroupID.y;
    if (x >= hd || y >= ws + nnew) return;
