#ifdef K_softmax_rows
layout(std430, binding = 0) readonly buffer BI { float16_t xin[]; };
layout(std430, binding = 1) writeonly buffer BY { float16_t y[]; };
layout(push_constant) uniform P { uint cols; };
shared float red[256];
void main() {
    uint row = gl_WorkGroupID.x, t = gl_LocalInvocationID.x;
    uint base = row * cols;
    float m = -1.0 / 0.0;
    for (uint i = t; i < cols; i += 256u) m = max(m, float(xin[base + i]));
    red[t] = m;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) { if (t < st) red[t] = max(red[t], red[t + st]); barrier(); }
    m = red[0];
    barrier();
    float sum = 0.0;
    for (uint i = t; i < cols; i += 256u) sum += exp(float(xin[base + i]) - m);
    red[t] = sum;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) { if (t < st) red[t] += red[t + st]; barrier(); }
    float inv = red[0] > 0.0 ? 1.0 / red[0] : 0.0;
    for (uint i = t; i < cols; i += 256u) y[base + i] = float16_t(exp(float(xin[base + i]) - m) * inv);
}
