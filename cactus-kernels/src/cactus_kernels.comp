                p += cc[0] * ((m==0)?c1s[A & 0xFu]:c3s[A & 0xFu]);
                p += cc[1] * ((m==0)?c1s[(A >> 8) & 0xFu]:c3s[(A >> 8) & 0xFu]);
                p += cc[2] * ((m==0)?c1s[(A >> 16) & 0xFu]:c3s[(A >> 16) & 0xFu]);
                p += cc[3] * ((m==0)?c1s[(A >> 24) & 0xFu]:c3s[(A >> 24) & 0xFu]);
                p += cc[4] * ((m==0)?c1s[(A >> 4) & 0xFu]:c3s[(A >> 4) & 0xFu]);
                p += cc[5] * ((m==0)?c1s[(A >> 12) & 0xFu]:c3s[(A >> 12) & 0xFu]);
                p += cc[6] * ((m==0)?c1s[(A >> 20) & 0xFu]:c3s[(A >> 20) & 0xFu]);
                p += cc[7] * ((m==0)?c1s[(A >> 28) & 0xFu]:c3s[(A >> 28) & 0xFu]);
                p += cc[8] * ((m==0)?c1s[B & 0xFu]:c3s[B & 0xFu]);
                p += cc[9] * ((m==0)?c1s[(B >> 8) & 0xFu]:c3s[(B >> 8) & 0xFu]);
                p += cc[10] * ((m==0)?c1s[(B >> 16) & 0xFu]:c3s[(B >> 16) & 0xFu]);
                p += cc[11] * ((m==0)?c1s[(B >> 24) & 0xFu]:c3s[(B >> 24) & 0xFu]);
                p += cc[12] * ((m==0)?c1s[(B >> 4) & 0xFu]:c3s[(B >> 4) & 0xFu]);
                p += cc[13] * ((m==0)?c1s[(B >> 12) & 0xFu]:c3s[(B >> 12) & 0xFu]);
                p += cc[14] * ((m==0)?c1s[(B >> 20) & 0xFu]:c3s[(B >> 20) & 0xFu]);
                p += cc[15] * ((m==0)?c1s[(B >> 28) & 0xFu]:c3s[(B >> 28) & 0xFu]);
                float nrm = float((m == 0) ? a1_h[nmb + (((n0 >> 2) * ng + gg) << 2) + r]
                                           : a3_h[nmb + (((n0 >> 2) * ng + gg) << 2) + r]);
                if (m == 0) gv[r] += nrm * p; else uv[r] += nrm * p;
            }
        }
    }
    for (uint r = 0u; r < 4u; ++r) {
        float gs2 = subgroupAdd(gv[r]);
        float us = subgroupAdd(uv[r]);
        if (lane == 0u && n0 + r < N) {
            float gh = h16(gs2);
            float a = (act == 1u) ? gelu_tanh(gh) : (gh / (1.0 + exp(-gh)));
            y[slotg * N + n0 + r] = float16_t(h16(a) * h16(us));
        }
    }
    }
}
