#ifdef K_bilinear
layout(std430, binding = 0) readonly buffer BI { float16_t xin[]; };
layout(std430, binding = 1) writeonly buffer BY { float16_t y[]; };
layout(push_constant) uniform P { uint sh; uint sw; uint dh; uint dw; uint E; uint align_c; };
void main() {
    uint e = gl_GlobalInvocationID.x, pix = gl_WorkGroupID.y;
    if (e >= E || pix >= dh * dw) return;
    uint dy = pix / dw, dx = pix - dy * dw;
    float syf, sxf;
    if (align_c != 0u) {
        float sc_h = (sh > 1u && dh > 1u) ? float(sh - 1u) / float(dh - 1u) : 0.0;
        float sc_w = (sw > 1u && dw > 1u) ? float(sw - 1u) / float(dw - 1u) : 0.0;
        syf = float(dy) * sc_h; sxf = float(dx) * sc_w;
    } else {
        float sc_h = (dh > 0u) ? float(sh) / float(dh) : 0.0;
        float sc_w = (dw > 0u) ? float(sw) / float(dw) : 0.0;
        syf = clamp((float(dy) + 0.5) * sc_h - 0.5, 0.0, float(sh) - 1.0);
        sxf = clamp((float(dx) + 0.5) * sc_w - 0.5, 0.0, float(sw) - 1.0);
    }
    int y0 = int(floor(syf)), x0 = int(floor(sxf));
    int y1 = min(y0 + 1, int(sh) - 1), x1 = min(x0 + 1, int(sw) - 1);
    float fy = syf - float(y0), fx = sxf - float(x0);
    float v00 = float(xin[(uint(y0) * sw + uint(x0)) * E + e]);
    float v01 = float(xin[(uint(y0) * sw + uint(x1)) * E + e]);
    float v10 = float(xin[(uint(y1) * sw + uint(x0)) * E + e]);
    float v11 = float(xin[(uint(y1) * sw + uint(x1)) * E + e]);
    y[pix * E + e] = float16_t(v00 * (1.0 - fx) * (1.0 - fy) + v01 * fx * (1.0 - fy)
