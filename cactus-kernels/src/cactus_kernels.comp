    uint stride = 64u * gl_NumWorkGroups.x;
    for (uint i = gl_GlobalInvocationID.x; i < n; i += stride) {
        uint outer = i / inner, in_i = i - outer * inner;
        uint base = outer * axis_size * inner + in_i;
        float r;
        if (op <= 2) {
            float sum = 0.0;
            for (uint a = 0u; a < axis_size; ++a) sum += rd(base + a * inner);
            float mean = sum / float(max(axis_size, 1u));
            if (op == 0) r = sum;
            else if (op == 1) r = mean;
            else {
                float varv = 0.0;
                for (uint a = 0u; a < axis_size; ++a) { float d = rd(base + a * inner) - mean; varv += d * d; }
                r = varv / float(max(axis_size, 1u));
            }
        } else {
            r = (axis_size > 0u) ? rd(base) : 0.0;
            for (uint a = 1u; a < axis_size; ++a) {
