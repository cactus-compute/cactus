#ifdef K_rope_full
layout(std430, binding = 0) readonly buffer BI { float16_t xin[]; };
layout(std430, binding = 1) buffer BY { float16_t y[]; };
layout(push_constant) uniform P { uint S; uint H; uint D; uint rot; uint pos0; uint gptj; float theta; };
void main() {
    uint idx = gl_GlobalInvocationID.x, tok = gl_WorkGroupID.y;
    uint hr = rot / 2u;
    if (idx >= hr) {
        uint d = rot + (idx - hr);
        if (d >= D) return;
        uint off = tok * D + d;
        y[off] = xin[off];
        return;
    }
    uint seq = (tok / H) % S;
    float freq = 1.0 / pow(theta, (2.0 * float(idx)) / float(rot));
    float angle = float(pos0 + seq) * freq;
    float c = h16(cos(angle));
    float sn = h16(sin(angle));
    uint d0 = (gptj != 0u) ? 2u * idx : idx;
