        uint sidx = (start_row + i) * hd + x;
        float v = (src_f32 != 0u) ? src_f[sidx] : float(src_h[sidx]);
        ring[ring_off + ((head0 + i) % ws) * hd + x] = float16_t(v);
        return;
    }
    uint pad = ws - count_new;
    if (y < pad) { outb[y * hd + x] = float16_t(0.0); return; }
    uint a = count_new - 1u - (y - pad);
