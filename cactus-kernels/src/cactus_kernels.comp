#ifdef K_groupnorm
layout(std430, binding = 0) readonly buffer BX { float16_t x[]; };
layout(std430, binding = 1) readonly buffer BW { float16_t w[]; };
layout(std430, binding = 2) readonly buffer BB { float16_t bias[]; };
layout(std430, binding = 3) writeonly buffer BY { float16_t y[]; };
layout(push_constant) uniform P { uint cpg; uint S; uint C; float eps; uint groups; };
shared float red[512];
void main() {
    uint g = gl_WorkGroupID.x % groups, nb = gl_WorkGroupID.x / groups, t = gl_LocalInvocationID.x;
    uint base = (nb * C + g * cpg) * S;
    uint count = cpg * S;
    float sum = 0.0, sq = 0.0;
    for (uint i = t; i < count; i += 256u) { float v = float(x[base + i]); sum += v; sq += v * v; }
    red[t] = sum; red[256u + t] = sq;
    barrier();
    for (uint s2 = 128u; s2 > 0u; s2 >>= 1u) {
        if (t < s2) { red[t] += red[t + s2]; red[256u + t] += red[256u + t + s2]; }
        barrier();
    }
    float mean = red[0] / float(count);
    float inv = 1.0 / sqrt(red[256] / float(count) - mean * mean + eps);
    for (uint i = t; i < count; i += 256u) {
        uint c = g * cpg + i / S;
        y[base + i] = float16_t((float(x[base + i]) - mean) * inv * float(w[c]) + float(bias[c]));
    }
}
#endif

#ifdef K_conv2d
layout(std430, binding = 0) readonly buffer BX { float16_t x[]; };
layout(std430, binding = 1) readonly buffer BW { float16_t w[]; };
layout(std430, binding = 2) readonly buffer BB { float16_t bias[]; };
layout(std430, binding = 3) writeonly buffer BY { float16_t y[]; };
layout(push_constant) uniform P { uint Cin; uint H; uint W; uint Cout; uint Ho; uint Wo;
    uint K; uint stride; uint pad; uint dw; uint has_bias; };
void main() {
    uint wo = gl_GlobalInvocationID.x, yy = gl_WorkGroupID.y;
    if (wo >= Wo) return;
    uint ho = yy % Ho, nco = yy / Ho;
    uint n = nco / Cout, co = nco - n * Cout;
    float acc = (has_bias != 0u) ? float(bias[co]) : 0.0;
    uint ci0 = (dw != 0u) ? co : 0u, ci1 = (dw != 0u) ? co + 1u : Cin;
    for (uint ci = ci0; ci < ci1; ++ci) {
        for (uint kh = 0u; kh < K; ++kh) {
            int h = int(ho * stride) - int(pad) + int(kh);
            if (h < 0 || h >= int(H)) continue;
            uint xr = ((n * Cin + ci) * H + uint(h)) * W;
            for (uint kw = 0u; kw < K; ++kw) {
                int ww = int(wo * stride) - int(pad) + int(kw);
                if (ww < 0 || ww >= int(W)) continue;
                float wv = (dw != 0u) ? float(w[(co * K + kh) * K + kw])
                                      : float(w[((co * Cin + ci) * K + kh) * K + kw]);
                acc += float(x[xr + uint(ww)]) * wv;
