#ifdef K_rms_norm_add_rows
layout(std430, binding = 0) readonly buffer BX { float16_t x[]; };
layout(std430, binding = 1) readonly buffer BR { float16_t res[]; };
layout(std430, binding = 2) readonly buffer BW { float16_t w[]; };
layout(std430, binding = 3) buffer BS { float16_t ysum[]; };
layout(std430, binding = 4) writeonly buffer BN { float16_t ynorm[]; };
layout(push_constant) uniform P { uint dim; float eps; uint rows; uint clipped; };
shared float red[64];
void main() {
    uint row = gl_WorkGroupID.x, t = gl_LocalInvocationID.x;
    if (row >= rows) return;
    uint base = row * dim;
    float partial = 0.0;
    for (uint i = t; i < dim; i += 64u) {
        float v = float(x[base + i]) + float(res[base + i]);
        if (clipped != 0u) v = clamp(v, -65500.0, 65500.0);
        float hv = h16(v);
        ysum[base + i] = float16_t(hv);
        partial += hv * hv;
    }
    red[t] = partial;
    barrier();
    for (uint st = 32u; st > 0u; st >>= 1u) { if (t < st) red[t] += red[t + st]; barrier(); }
    float inv = 1.0 / sqrt(red[0] / float(dim) + eps);
    for (uint i = t; i < dim; i += 64u)
        ynorm[base + i] = float16_t(float(ysum[base + i]) * inv * float(w[i]));
}
#endif

#ifdef K_attn_prefill_i8
layout(std430, binding = 0) readonly buffer BQ { float16_t q[]; };
layout(std430, binding = 1) readonly buffer BKN { float16_t knew[]; };
layout(std430, binding = 2) readonly buffer BVN { float16_t vnew[]; };
layout(std430, binding = 3) readonly buffer BKC { uint kc[]; };
layout(std430, binding = 4) readonly buffer BVC { uint vc[]; };
layout(std430, binding = 5) readonly buffer BKS { float ks[]; };
layout(std430, binding = 6) readonly buffer BVS { float vs[]; };
layout(std430, binding = 7) writeonly buffer BO { float16_t outb[]; };
layout(push_constant) uniform P { uint nqh; uint nkvh; uint hd; uint vhd; uint hist;
    float scale; uint q_pos0; uint new_len; uint is_causal; uint window;
    uint o_kc; uint o_vc; uint o_ks; uint o_vs; };
shared float sc[256];
shared float red[128];
float sbyte(uint wv, uint d) { int b = int((wv >> ((d & 3u) * 8u)) & 0xFFu); return float((b << 24) >> 24); }
void main() {
    uint fid = gl_WorkGroupID.x, t = gl_LocalInvocationID.x;
    const uint T = 128u;
    uint h = fid % nqh, m = fid / nqh;
    uint kvh = h / (nqh / nkvh);
    uint ngK = (hd + 31u) / 32u, ngV = (vhd + 31u) / 32u;
    uint total_keys = hist + new_len;
    uint pos_m = q_pos0 + m;
    uint kv_end = (is_causal != 0u) ? min(total_keys, pos_m + 1u) : total_keys;
    uint kv_start = (window != 0u && pos_m + 1u > window) ? (pos_m + 1u - window) : 0u;
    uint qb = (m * nqh + h) * hd;
    uint ob = (m * nqh + h) * vhd;
    if (kv_end == 0u || kv_start >= kv_end) {
        for (uint d = t; d < vhd; d += T) outb[ob + d] = float16_t(0.0);
        return;
    }
    const uint TILE = 256u;
    float rmax = -1.0 / 0.0, rsum = 0.0;
    float acc[8];
    for (uint a = 0u; a < 8u; ++a) acc[a] = 0.0;
    for (uint tile = (kv_start / TILE) * TILE; tile < kv_end; tile += TILE) {
        uint tcount = min(TILE, kv_end - tile);
        for (uint jj = t; jj < tcount; jj += T) {
            uint k = tile + jj;
            if (k < kv_start) { sc[jj] = -1.0 / 0.0; continue; }
            float dt = 0.0;
            if (k < hist) {
                uint krow = (k * nkvh + kvh) * hd;
                uint srow = (k * nkvh + kvh) * ngK;
                for (uint d = 0u; d < hd; ++d)
                    dt += float(q[qb + d]) * (sbyte(kc[o_kc + ((krow + d) >> 2)], d) * ks[o_ks + srow + d / 32u]);
            } else {
                uint krow = ((k - hist) * nkvh + kvh) * hd;
                for (uint d = 0u; d < hd; ++d) dt += float(q[qb + d]) * float(knew[krow + d]);
            }
            sc[jj] = dt * scale;
        }
        barrier();
        float lmax = -1.0 / 0.0;
        for (uint jj = t; jj < tcount; jj += T) lmax = max(lmax, sc[jj]);
        red[t] = lmax;
        barrier();
        for (uint s = 64u; s > 0u; s >>= 1u) { if (t < s) red[t] = max(red[t], red[t + s]); barrier(); }
        float tmax = red[0];
        barrier();
        float rmax_new = max(rmax, tmax);
        float resc = exp(rmax - rmax_new);
        for (uint jj = t; jj < tcount; jj += T) sc[jj] = exp(sc[jj] - rmax_new);
        barrier();
        float lsum = 0.0;
        for (uint jj = t; jj < tcount; jj += T) lsum += sc[jj];
        red[t] = lsum;
        barrier();
        for (uint s = 64u; s > 0u; s >>= 1u) { if (t < s) red[t] += red[t + s]; barrier(); }
        float tsum = red[0];
        barrier();
        rsum = rsum * resc + tsum;
        uint ai = 0u;
        for (uint d = t; d < vhd; d += T) {
            float a = acc[ai] * resc;
            for (uint jj = 0u; jj < tcount; ++jj) {
                uint k = tile + jj;
                float vv;
                if (k < hist) {
                    uint vrow = (k * nkvh + kvh) * vhd;
                    uint srow = (k * nkvh + kvh) * ngV;
                    vv = sbyte(vc[o_vc + ((vrow + d) >> 2)], d) * vs[o_vs + srow + d / 32u];
                } else {
                    uint vrow = ((k - hist) * nkvh + kvh) * vhd;
                    vv = float(vnew[vrow + d]);
                }
                a += sc[jj] * vv;
            }
            acc[ai] = a; ++ai;
        }
        rmax = rmax_new;
        barrier();
    }
    float inv = rsum > 0.0 ? 1.0 / rsum : 0.0;
    uint ai = 0u;
    for (uint d = t; d < vhd; d += T) { outb[ob + d] = float16_t(acc[ai] * inv); ++ai; }
}
#endif

#ifdef K_attn_prefill_ring_i8
layout(std430, binding = 0) readonly buffer BQ { float16_t q[]; };
layout(std430, binding = 1) readonly buffer BKN { float16_t knew[]; };
layout(std430, binding = 2) readonly buffer BVN { float16_t vnew[]; };
layout(std430, binding = 3) readonly buffer BKC { uint kc[]; };
layout(std430, binding = 4) readonly buffer BVC { uint vc[]; };
layout(std430, binding = 5) readonly buffer BKS { float ks[]; };
layout(std430, binding = 6) readonly buffer BVS { float vs[]; };
layout(std430, binding = 7) writeonly buffer BO { float16_t outb[]; };
layout(push_constant) uniform P { uint nqh; uint nkvh; uint hd; uint vhd; uint hist;
    float scale; uint q_pos0; uint new_len; uint is_causal; uint sinkN; uint ringR;
    uint o_kc; uint o_vc; uint o_ks; uint o_vs; };
shared float sc[7936];
shared float red[128];
float sbyte(uint wv, uint d) { int b = int((wv >> ((d & 3u) * 8u)) & 0xFFu); return float((b << 24) >> 24); }
void main() {
    uint fid = gl_WorkGroupID.x, t = gl_LocalInvocationID.x;
    const uint T = 128u;
    uint h = fid % nqh, m = fid / nqh;
    uint kvh = h / (nqh / nkvh);
    uint ngK = (hd + 31u) / 32u, ngV = (vhd + 31u) / 32u;
    uint total_keys = hist + new_len;
    uint pos_m = q_pos0 + m;
    uint kv_end = (is_causal != 0u) ? min(total_keys, pos_m + 1u) : total_keys;
    uint S = sinkN;
    uint Wsr = S + ringR;
    uint rstart, nactive;
    if (kv_end > Wsr) { rstart = kv_end - ringR; nactive = Wsr; }
    else { rstart = S; nactive = kv_end; }
    uint qb = (m * nqh + h) * hd;
    uint ob = (m * nqh + h) * vhd;
    if (nactive == 0u) {
        for (uint d = t; d < vhd; d += T) outb[ob + d] = float16_t(0.0);
        return;
    }
    float lmax = -1.0 / 0.0;
    for (uint j = t; j < nactive; j += T) {
        uint k = (j < S) ? j : rstart + (j - S);
        float dt = 0.0;
        if (k < hist) {
            uint slot = (k >= Wsr) ? (S + ((k - S) % ringR)) : k;
            uint krow = (slot * nkvh + kvh) * hd;
            uint srow = (slot * nkvh + kvh) * ngK;
            for (uint d = 0u; d < hd; ++d)
                dt += float(q[qb + d]) * (sbyte(kc[o_kc + ((krow + d) >> 2)], d) * ks[o_ks + srow + d / 32u]);
        } else {
            uint krow = ((k - hist) * nkvh + kvh) * hd;
            for (uint d = 0u; d < hd; ++d) dt += float(q[qb + d]) * float(knew[krow + d]);
        }
        float s = dt * scale;
        sc[j] = s;
        lmax = max(lmax, s);
    }
    red[t] = lmax;
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1u) { if (t < s) red[t] = max(red[t], red[t + s]); barrier(); }
    float gmax = red[0];
    barrier();
    float lsum = 0.0;
    for (uint j = t; j < nactive; j += T) { float e = exp(sc[j] - gmax); sc[j] = e; lsum += e; }
    red[t] = lsum;
    barrier();
    for (uint s = 64u; s > 0u; s >>= 1u) { if (t < s) red[t] += red[t + s]; barrier(); }
    float inv = red[0] > 0.0 ? 1.0 / red[0] : 0.0;
    barrier();
    for (uint d = t; d < vhd; d += T) {
        float a = 0.0;
        for (uint j = 0u; j < nactive; ++j) {
            uint k = (j < S) ? j : rstart + (j - S);
            float vv;
            if (k < hist) {
                uint slot = (k >= Wsr) ? (S + ((k - S) % ringR)) : k;
                uint vrow = (slot * nkvh + kvh) * vhd;
                uint srow = (slot * nkvh + kvh) * ngV;
                vv = sbyte(vc[o_vc + ((vrow + d) >> 2)], d) * vs[o_vs + srow + d / 32u];
            } else {
                uint vrow = ((k - hist) * nkvh + kvh) * vhd;
                vv = float(vnew[vrow + d]);
            }
            a += sc[j] * vv;
        }
        outb[ob + d] = float16_t(a * inv);
    }
}
#endif

#ifdef K_attn_f16
layout(std430, binding = 0) readonly buffer BQ { float16_t q[]; };
layout(std430, binding = 1) readonly buffer BK { float16_t k[]; };
layout(std430, binding = 2) readonly buffer BV { float16_t v[]; };
layout(std430, binding = 3) writeonly buffer BO { float16_t o[]; };
layout(std430, binding = 4) readonly buffer BM { float16_t mask_v[]; };
layout(push_constant) uniform P { uint T; uint S; uint HQ; uint HKV; uint D; uint DV;
    float scale; uint causal; uint pos_off; uint window; float logit_cap; uint mask_mode;
    uint o_k; uint o_v; };
shared float qsh[1024];
shared float sc[128];
shared float red[128];
void main() {
    const uint TT = 128u;
    uint fid = gl_WorkGroupID.x, tl = gl_LocalInvocationID.x;
    uint h = fid % HQ, bt = fid / HQ;
    uint t = bt % T, b = bt / T;
    uint kvh = h / (HQ / HKV);
    uint qb = ((b * T + t) * HQ + h) * D;
    uint ob = ((b * T + t) * HQ + h) * DV;
    uint kb = o_k + (b * S * HKV + kvh) * D;
    uint vb = o_v + (b * S * HKV + kvh) * DV;
    for (uint d = tl; d < D; d += TT) qsh[d] = float(q[qb + d]);
    barrier();
    uint aq = pos_off + t;
    uint kend = (causal != 0u) ? min(S, aq + 1u) : S;
    uint kstart = 0u;
    if (window > 0u && aq > window) kstart = aq - window;
    float rmax = -1.0 / 0.0, rsum = 0.0;
    float acc[8];
    for (uint a = 0u; a < 8u; ++a) acc[a] = 0.0;
    for (uint tile = kstart; tile < kend; tile += TT) {
        uint tcount = min(TT, kend - tile);
        if (tl < tcount) {
            uint i = tile + tl;
            float dt = 0.0;
            uint kr = kb + i * HKV * D;
            for (uint d = 0u; d < D; ++d) dt += qsh[d] * float(k[kr + d]);
            float s = dt * scale;
            if (window > 0u && i < aq && (aq - i) > window) s = -1.0 / 0.0;
            if (mask_mode != 0u) {
                uint mi = (mask_mode >= 3u) ? (((b * HQ + h) * T + t) * S + i)
                                            : ((b * T + t) * S + i);
                float mv = float(mask_v[mi]);
                if (mask_mode == 1u || mask_mode == 3u) {
                    if (isinf(mv) || isnan(mv)) s = -1.0 / 0.0; else s += mv;
                } else if (mv == 0.0) s = -1.0 / 0.0;
            }
            if (logit_cap > 0.0 && !isinf(s)) s = logit_cap * tanh(clamp(s / logit_cap, -30.0, 30.0));
            sc[tl] = s;
        } else {
            sc[tl] = -1.0 / 0.0;
        }
        red[tl] = sc[tl];
        barrier();
        for (uint st = 64u; st > 0u; st >>= 1u) { if (tl < st) red[tl] = max(red[tl], red[tl + st]); barrier(); }
        float tmax = red[0];
        barrier();
        if (tmax > -1.0 / 0.0) {
            float rmax_new = max(rmax, tmax);
            float resc = (rmax > -1.0 / 0.0) ? exp(rmax - rmax_new) : 0.0;
            float e = (tl < tcount && sc[tl] > -1.0 / 0.0) ? exp(sc[tl] - rmax_new) : 0.0;
            sc[tl] = e;
            red[tl] = e;
            barrier();
            for (uint st = 64u; st > 0u; st >>= 1u) { if (tl < st) red[tl] += red[tl + st]; barrier(); }
            float tsum = red[0];
            barrier();
            rsum = rsum * resc + tsum;
            uint ai = 0u;
            for (uint d = tl; d < DV; d += TT) {
                float a = acc[ai] * resc;
                for (uint jj = 0u; jj < tcount; ++jj) {
                    float w = sc[jj];
                    if (w != 0.0) a += w * float(v[vb + (tile + jj) * HKV * DV + d]);
                }
                acc[ai] = a; ++ai;
            }
            rmax = rmax_new;
        }
        barrier();
    }
    float inv = rsum > 0.0 ? 1.0 / rsum : 0.0;
    uint ai = 0u;
    for (uint d = tl; d < DV; d += TT) { o[ob + d] = float16_t(acc[ai] * inv); ++ai; }
}
#endif

#ifdef K_layer_norm
layout(std430, binding = 0) readonly buffer BI { float16_t xin[]; };
layout(std430, binding = 1) readonly buffer BW { float16_t w[]; };
layout(std430, binding = 2) readonly buffer BB { float16_t bias[]; };
layout(std430, binding = 3) writeonly buffer BY { float16_t y[]; };
layout(push_constant) uniform P { uint dim; float eps; uint has_bias; };
shared float red[512];
void main() {
    uint row = gl_WorkGroupID.x, t = gl_LocalInvocationID.x;
    uint base = row * dim;
    float s = 0.0, ss = 0.0;
    for (uint i = t; i < dim; i += 256u) { float v = float(xin[base + i]); s += v; ss += v * v; }
    red[t] = s; red[256u + t] = ss;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) {
        if (t < st) { red[t] += red[t + st]; red[256u + t] += red[256u + t + st]; }
        barrier();
    }
    float mean = red[0] / float(dim);
    float varv = red[256] / float(dim) - mean * mean;
    float inv = 1.0 / sqrt(varv + eps);
    for (uint i = t; i < dim; i += 256u) {
        float v = (float(xin[base + i]) - mean) * inv * float(w[i]);
        if (has_bias != 0u) v += float(bias[i]);
        y[base + i] = float16_t(v);
    }
}
