layout(std430, binding = 5) readonly buffer BS0H { float16_t s0_h[]; };
layout(std430, binding = 6) readonly buffer BS0F { float s0_f[]; };
layout(std430, binding = 7) readonly buffer BS1H { float16_t s1_h[]; };
layout(std430, binding = 8) readonly buffer BS1F { float s1_f[]; };
layout(std430, binding = 9) readonly buffer BS2H { float16_t s2_h[]; };
layout(std430, binding = 10) readonly buffer BS2F { float s2_f[]; };
layout(push_constant) uniform P { uint nsteps; uint n; uint flags; uint inner; };
float sside(uint slot, bool f32, uint si) {
    if (slot == 0u) return f32 ? s0_f[si] : float(s0_h[si]);
    if (slot == 1u) return f32 ? s1_f[si] : float(s1_h[si]);
    return f32 ? s2_f[si] : float(s2_h[si]);
}
float sc_apply(float v, float p, int op) {
    if (op == 0) return v + p;
    if (op == 1) return v - p;
    if (op == 3) return v / p;
    if (op == 4) return exp(v);
    if (op == 5) return sqrt(v);
    if (op == 6) return cos(v);
    if (op == 7) return sin(v);
    if (op == 8) return log(v);
    if (op == 9) return abs(v);
    if (op == 10) return pow(v, p);
    if (op == 11) return (v != p) ? 1.0 : 0.0;
    if (op == 12) return (v > 0.0) ? v : v * p;
