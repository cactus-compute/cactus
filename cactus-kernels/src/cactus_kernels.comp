#ifdef K_gemv_bias
layout(std430, binding = 0) readonly buffer BX { float16_t x[]; };
layout(std430, binding = 1) readonly buffer BW { float16_t w[]; };
layout(std430, binding = 2) readonly buffer BB { float16_t bias[]; };
layout(std430, binding = 3) writeonly buffer BY { float16_t y[]; };
layout(push_constant) uniform P { uint K; uint N; uint tr; };
void main() {
    uint stride = 64u * gl_NumWorkGroups.x;
    for (uint n = gl_GlobalInvocationID.x; n < N; n += stride) {
        float acc = 0.0;
        if (tr != 0u) {
            uint wb = n * K;
            for (uint kk = 0u; kk < K; ++kk) acc += float(x[kk]) * float(w[wb + kk]);
        } else {
            for (uint kk = 0u; kk < K; ++kk) acc += float(x[kk]) * float(w[kk * N + n]);
        }
        y[n] = float16_t(h16(acc) + float(bias[n]));
