# Copy to .env (untracked) and fill in your Cactus Cloud key.
# The engine reads CACTUS_CLOUD_KEY at handoff time (header: X-API-Key).
CACTUS_CLOUD_KEY=ck_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides (defaults shown; match the engine fallbacks):
# CACTUS_CLOUD_MODEL=gemini-2.5-flash
# CACTUS_CLOUD_API_BASE=https://104.198.76.3/api/v1
# Do NOT set CACTUS_CLOUD_STRICT_SSL -- the IP endpoint needs verification OFF.
